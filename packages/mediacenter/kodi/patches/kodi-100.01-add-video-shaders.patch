+
+float2 CShaderUtils::GetOptimalTextureSize(float2 videoSize)
+{
+  unsigned sizeMax = videoSize.Max<unsigned>();
+  unsigned size = 1;
+
+  // Find smallest possible power-of-two size that can contain input texture
+  while (true)
+  {
+    if (size >= sizeMax)
+      break;
+    size *= 2;
+  }
+  return float2(size, size);
+}
